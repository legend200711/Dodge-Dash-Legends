{
  "name": "dodge-dash-legends",
  "version": "1.0.0",
  "description": "3D Arcade Racing - dodge traffic, collect power-ups, race to the finish!",
  "main": "main.js",
  "author": "Dodge Dash Legends",
  "license": "MIT",
  "scripts": {
    "start":       "electron .",
    "build:win":   "electron-builder --win --x64",
    "build:mac":   "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron":         "^29.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId":       "com.dodgedashlegends.app",
    "productName": "Dodge Dash Legends",
    "copyright":   "Copyright © 2024 Dodge Dash Legends",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "game/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "game/icons/icon-512.png"
    },
    "nsis": {
      "oneClick":          false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName":      "Dodge Dash Legends"
    }
  }
}
